#!/bin/sh
# The `wa` binary's wrapper: the Lua suites ARE this binary (one per WA_SCRIPT), so measuring them means
# running it through the same wrapper as the *.cjs/*.mjs/*.sh/*.ps1 suites. scripts/test.sh points BIN at
# this file and hands the real path over in WA_GATE_REAL_BIN, so unlike the bash/node/powershell shims
# there is no PATH lookup to do. Measurement only: same argv, same environment, inherited stdio, real
# exit code (see scripts/lib/gate-suite.mjs).
set -u
here=$(cd "$(dirname "$0")" && pwd)
real=${WA_GATE_REAL_BIN:-rust/target/release/wa}
# scripts/test.sh spells the binary without `.exe` and lets MSYS add it, so an executability test that
# only ever looks at the literal name would refuse the binary the gate itself runs happily. Try the
# literal name, then the `.exe` spelling, before refusing - a refusal here would be 127 for every Lua
# suite in the gate, which is a loud failure but a needless one.
if [ ! -x "$real" ] && [ -x "$real.exe" ]; then real="$real.exe"; fi
if [ ! -x "$real" ]; then
  echo "gate shim: the real binary $real is not executable (WA_GATE_REAL_BIN=$real)" >&2
  exit 127
fi
filtered=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v '/gate-shims$' | paste -sd: -)
runner=$(PATH="$filtered" command -v node 2>/dev/null || true)
if [ -z "$runner" ]; then
  echo "gate shim: node is not on PATH outside $here" >&2
  exit 127
fi
if command -v cygpath >/dev/null 2>&1; then
  case "$real" in /*) real=$(cygpath -w "$real") ;; esac
  case "$runner" in /*) runner=$(cygpath -w "$runner") ;; esac
fi
name="$(basename "${WA_SCRIPT:-wa}")"
exec "$runner" "$here/../gate-suite.mjs" --name "lua:${name}" -- "$real" "$@"

#!/data/data/com.termux/files/usr/bin/sh
# Termux launcher for the wasm-agent developer preview.
set -eu

install_root=${WA_TERMUX_INSTALL:-"${PREFIX:-/data/data/com.termux/files/usr}/opt/wasm-agent-preview"}
native="$install_root/wa"
ui="$install_root/ui"
config_root=${WASM_AGENT_HOME:-"$HOME"}
config="$config_root/.wasm-agent"

fail() {
  printf '%s\n' "termux: $*" >&2
  exit 1
}

config_value() {
  key=$1
  [ -f "$config/env" ] || return 0
  sed -n "s/^${key}=//p" "$config/env" | head -n 1
}

# The same one-key reader for any file of `key=value` lines (installed.txt).
config_value_on() {
  [ -f "$1" ] || return 0
  sed -n "s/^$2=//p" "$1" | head -n 1
}

need_runtime() {
  [ -f "$native" ] || fail "runtime_missing: run scripts/install-termux.sh from a wasm-agent checkout"
}

# Only the commands that actually exec the runtime require it to be executable; `wa setup`,
# `wa doctor` and `wa update` read and describe the install without running it.
need_executable() {
  [ -x "$native" ] || fail "runtime_not_executable: $native"
}

valid_line() {
  [ -n "$1" ] && [ "$(printf '%s' "$1" | wc -l)" -eq 0 ]
}

read_value() {
  label=$1
  default=${2:-}
  if [ -n "$default" ]; then
    printf '%s [%s]: ' "$label" "$default" >&2
  else
    printf '%s: ' "$label" >&2
  fi
  IFS= read -r answer || fail "input_closed"
  [ -n "$answer" ] || answer=$default
  valid_line "$answer" || fail "invalid_value: $label"
  printf '%s' "$answer"
}

setup() {
  need_runtime
  mkdir -p "$config"
  chmod 700 "$config"
  saved_workspace=$(config_value WASM_AGENT_WORKSPACE)
  current_workspace=${WASM_AGENT_WORKSPACE:-${saved_workspace:-"$HOME"}}
  name=$(read_value "Agent display name" "Android agent")
  workspace=$(read_value "Full path to an existing workspace" "$current_workspace")
  [ "${workspace#/}" != "$workspace" ] || fail "workspace_must_be_absolute"
  [ -d "$workspace" ] || fail "workspace_not_found: $workspace"
  base_url=$(read_value "Compatible provider URL" "https://api.openai.com/v1")
  case "$base_url" in
    https://*|http://127.0.0.1:*|http://localhost:*) ;;
    *) fail "provider_url_requires_https_or_loopback_http" ;;
  esac
  model=$(read_value "Model name" "gpt-5")
  printf 'API key (input hidden; leave empty to preserve the existing key): ' >&2
  old_stty=$(stty -g 2>/dev/null || true)
  [ -z "$old_stty" ] || stty -echo
  IFS= read -r api_key || api_key=
  [ -z "$old_stty" ] || stty "$old_stty"
  printf '\n' >&2
  valid_line "$name" && valid_line "$base_url" && valid_line "$model" || fail "invalid_setup_value"

  old_key=$(config_value WASM_AGENT_LLM_API_KEY)
  [ -n "$api_key" ] || api_key=$old_key
  [ -n "$api_key" ] || fail "api_key_required_on_first_setup"

  temporary="$config/.env.$$"
  umask 077
  : > "$temporary"
  chmod 600 "$temporary"
  {
    printf 'WASM_AGENT_ONBOARDING_MODE=personal\n'
    printf 'WASM_AGENT_DISPLAY_NAME=%s\n' "$name"
    printf 'WASM_AGENT_WORKSPACE=%s\n' "$workspace"
    printf 'WASM_AGENT_LLM_BASE_URL=%s\n' "$base_url"
    printf 'WASM_AGENT_LLM_MODEL=%s\n' "$model"
    printf 'WASM_AGENT_LLM_API_KEY=%s\n' "$api_key"
  } > "$temporary"
  mv "$temporary" "$config/env"
  chmod 600 "$config/env"
  printf '%s\n' "Configuration saved in $config/env. Provider not validated."
  printf '%s\n' "Run 'wa ui' to start the local node and open its browser UI."
}

doctor() {
  need_runtime
  printf 'Runtime: %s\n' "$native"
  printf 'Architecture: %s\n' "$(uname -m)"
  # Which rung of the build ladder produced this runtime: an unoptimized build is a real
  # outcome on a phone that cannot optimize a crate this size, and it is worth saying out
  # loud rather than leaving the operator to wonder why it is slow.
  build_profile=$(config_value_on "$install_root/installed.txt" build_profile)
  case "$build_profile" in
    dev|debug)
      printf 'Build: %s (unoptimized: slower, and installed because the optimized build did not finish on this device)\n' "$build_profile"
      ;;
    cross-android)
      # A prebuilt bundle: the runtime was cross-built on a desktop with the Android NDK and
      # installed from bytes, because compiling this workspace on this phone crashed rustc.
      # Saying so matters - "why is this not a build from my device" is a real question.
      printf 'Build: cross-android (prebuilt with the Android NDK on a desktop, installed from a verified bundle; not compiled on this device)\n'
      ndk_version=$(config_value_on "$install_root/installed.txt" ndk_version)
      if [ -n "$ndk_version" ]; then printf 'Cross-build: NDK %s\n' "$ndk_version"; fi
      ;;
    '') printf 'Build: unknown (no build_profile recorded; a release from before the build ladder)\n' ;;
    *) printf 'Build: %s\n' "$build_profile" ;;
  esac
  printf 'UI assets: %s\n' "$(if [ -f "$ui/index.html" ]; then printf present; else printf missing; fi)"
  printf 'Configuration: %s\n' "$(if [ -f "$config/env" ]; then printf present; else printf "missing; run wa setup"; fi)"
  printf 'ripgrep: %s\n' "$(if command -v rg >/dev/null 2>&1; then command -v rg; else printf missing; fi)"
  printf '%s\n' 'Authority: Termux app sandbox; this workspace is not an additional filesystem sandbox.'
  [ -f "$ui/index.html" ] && command -v rg >/dev/null 2>&1 && [ -f "$config/env" ]
}

open_ui() {
  need_runtime
  need_executable
  [ -f "$ui/index.html" ] || fail "ui_assets_missing"
  port=8799
  no_open=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --port) [ "$#" -ge 2 ] || fail "port_value_required"; port=$2; shift 2 ;;
      --no-open) no_open=1; shift ;;
      *) fail "unknown_ui_option: $1" ;;
    esac
  done
  case "$port" in *[!0-9]*|'') fail "invalid_port" ;; esac
  [ "$port" -ge 1024 ] && [ "$port" -le 65534 ] || fail "invalid_port"
  url="http://127.0.0.1:$port/"
  if [ "$no_open" -eq 0 ]; then
    if command -v termux-open-url >/dev/null 2>&1; then
      (sleep 1; termux-open-url "$url" >/dev/null 2>&1 || true) &
    else
      printf 'Open %s in this phone browser.\n' "$url"
    fi
  fi
  printf 'Starting wasm-agent at %s; keep this Termux session running.\n' "$url"
  saved_workspace=$(config_value WASM_AGENT_WORKSPACE)
  workspace=${WASM_AGENT_WORKSPACE:-${saved_workspace:-"$HOME"}}
  [ -d "$workspace" ] || fail "workspace_not_found: $workspace"
  cd "$workspace"
  exec "$native" serve --port "$port" --client-port "$((port + 1))" --ui "$ui"
}

update() {
  need_runtime
  updater="$install_root/bin/wa-update"
  [ -f "$updater" ] || fail "updater_missing: $updater (this install predates 'wa update'; run the one-time bootstrap: bash scripts/install-termux.sh --adopt-existing)"
  [ -f "$install_root/bin/release-lib.sh" ] || fail "updater_incomplete: $install_root/bin/release-lib.sh"
  # Run the updater from a private copy, not from the release it is about to replace. Two
  # reasons, both real: a shell reading a script that is moved out from under it can lose
  # the rest of the file, and Windows refuses to move a directory that holds an open
  # script at all. The copy is outside every directory this command may move.
  run_dir=$(mktemp -d "${TMPDIR:-/tmp}/wa-update.XXXXXX") || fail "cannot create a private run directory"
  cleanup_run() { rm -rf -- "$run_dir"; }
  trap cleanup_run EXIT HUP INT TERM
  cp "$updater" "$run_dir/wa-update" || fail 'cannot copy the updater'
  cp "$install_root/bin/release-lib.sh" "$run_dir/release-lib.sh" || fail 'cannot copy the updater library'
  chmod 700 "$run_dir" 2>/dev/null || true
  set +e
  sh "$run_dir/wa-update" "$@"
  code=$?
  set -e
  exit "$code"
}

command=${1:-help}
[ "$#" -eq 0 ] || shift
case "$command" in
  setup) setup "$@" ;;
  doctor) doctor "$@" ;;
  update) update "$@" ;;
  ui) open_ui "$@" ;;
  help|--help|-h)
    printf '%s\n' 'Termux preview: wa setup | wa doctor | wa ui [--port N] [--no-open] | wa update [--check|--rollback]'
    printf '%s\n' 'All other commands are passed to the native wasm-agent CLI.'
    ;;
  *) need_runtime; need_executable; exec "$native" "$command" "$@" ;;
esac

# wasm-agent node configuration.
#
# Copy to ~/.wasm-agent/env and fill in. The host reads this file at startup and
# does NOT overwrite variables that are already set in the real environment.
# Never commit the filled-in file.

# ---- model provider --------------------------------------------------------
WASM_AGENT_LLM_BASE_URL=https://opencode.ai/zen/go/v1
WASM_AGENT_LLM_API_KEY=
WASM_AGENT_LLM_MODEL=deepseek-v4.1-flash
# Context window: drives the status meter and automatic compaction.
WASM_AGENT_LLM_CONTEXT=128000
# Compaction policy (borrowed from pi): compact only when the context is within
# `reserve` of the window, and summarise everything older than `keep` tokens.
#WASM_AGENT_COMPACT_RESERVE=16384
#WASM_AGENT_COMPACT_KEEP=20000
# Optional cheaper model for compaction; falls back to the main model.
#WASM_AGENT_LLM_SUMMARY_MODEL=glm-5.3-flash
# Optional second provider profile (the `gpt` entry in the model picker).
#OPENAI_API_KEY=

# ---- prompt caching --------------------------------------------------------
# Providers cache the request prefix (system + tools + history) and reuse it when
# it is byte-identical. A routing key pins a conversation to the same cache.
#   auto (default) - send only to providers known to honour it (api.openai.com)
#   on / off       - force, or never send
#WASM_AGENT_PROMPT_CACHE_KEY=auto
# Extended retention where supported (OpenAI accepts "24h").
#WASM_AGENT_PROMPT_CACHE_RETENTION=24h
# USD per million tokens, per model. Unset = report tokens, no cost.
# {"input":miss price,"output":price,"cacheRead":hit price,"cacheWrite":write price}
#WASM_AGENT_MODEL_RATES={"deepseek-v4.1-flash":{"input":0.28,"output":0.42,"cacheRead":0.028}}

# ---- node fabric -----------------------------------------------------------
# Registry + relay (the always-on instance).
WASM_AGENT_RENDEZVOUS=https://rendezvous.colmeio.com
WASM_AGENT_RELAY=https://rendezvous.colmeio.com
# How peers reach this node. Leave EMPTY to be relay-only (works behind NAT).
WASM_AGENT_ENDPOINT=
WASM_AGENT_NODE_NAME=openclaw
# Comma-separated peers to push the replication journal to (diff sync).
#WASM_AGENT_SYNC_TO=openclaw

# ---- misc ------------------------------------------------------------------
# Instructions injected every turn, scoped by role (a guest never falls back to
# the operator file). Defaults to ./AGENTS.md and ./AGENTS.guest.md anyway.
#WASM_AGENT_AGENTS_MD=/local/projects/wasm-agent/AGENTS.md
#WASM_AGENT_AGENTS_MD_GUEST=/local/projects/wasm-agent/AGENTS.guest.md
# Node key file. One node per machine by default; override to run more than one.
#WASM_AGENT_NODE_KEY=/home/ubuntu/.wasm-agent/node.key

# Agent loop guard. A turn is bounded by context, not by rounds: when the request
# approaches the window the turn compacts mid-turn (a "split turn") and continues.
# This ceiling only stops a runaway loop, so it should never fire in practice.
#WASM_AGENT_MAX_TOOL_ROUNDS=200

# ---- environment children inherit ------------------------------------------
# PATH for every process the node starts, including remote tool calls. A
# service does not get a login shell, so a toolchain installed in ~/.cargo/bin
# is invisible to `host.exec` and a remote `cargo build` fails with
# "sh: 1: cargo: not found" - with nothing else reporting it. `wa status`
# prints a tools line that resolves git, ssh and cargo for exactly this.
# WASM_AGENT_PATH_NOTE (this comment) exists so the section is easy to find.
#PATH=/home/ubuntu/.cargo/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

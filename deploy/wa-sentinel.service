# The sentinel as a service.
#
# It has to survive the node, so it must not be a child of it: a supervisor that dies with the thing it
# supervises is decoration. This is the same reasoning as the drop-box - the process that can restart
# your agent must not be reachable from it.
#
#   sudo cp deploy/wa-sentinel.service /etc/systemd/system/
#   sudo systemctl enable --now wa-sentinel
#
# Windows native SCM hosting is described in docs/WINDOWS-SENTINEL-SERVICE.md and installed explicitly
# with scripts/install-sentinel-service.ps1 under a provisioned non-administrator service account.
# Its exact paths/environment are config, not an inherited interactive console. The existing Windows
# logon task remains a fallback until live SCM identity/recovery/deploy proof succeeds; never register
# a console `watch` executable as a service without its native service dispatcher.
#
[Unit]
Description=wasm-agent sentinel (restarts, upgrades, and wakes the node from outside)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The node's own service, so the sentinel starts first and can watch it come up.
ExecStart=/usr/local/bin/wa-sentinel watch
Restart=always
RestartSec=5
# Same home as the node: the drop-box, the log and the triggers all live beside its config.
Environment=WASM_AGENT_HOME=/home/ubuntu
# Where the sentinel may execute `run` scripts from. Without it every `run` job is refused with
# "run is disabled: set WA_SENTINEL_SCRIPTS". Both install locations are named because the unit starts
# the binary from /usr/local/bin while upgrades install to ~/.local/bin on this host.
Environment=WA_SENTINEL_SCRIPTS=/usr/local/bin/scripts;/home/ubuntu/.local/bin/scripts
WorkingDirectory=/usr/local/bin
# Waking the model costs money, so the budget is set where an operator can see it.
Environment=WA_SENTINEL_WAKE_BUDGET=6
# To the journal, which rotates; `append:` to sentinel.out grew without bound.
# Read it with: journalctl -u wa-sentinel
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

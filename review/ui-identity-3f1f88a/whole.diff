@@ -0,0 +1,7 @@
+// Caller-attested source/build binding. Not binary introspection or a security boundary.
+const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),{spawnSync}=require('node:child_process');
+const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
+function sources(repo){const out={};for(const file of ['rust/wa-host/src/serve.rs','rust/wa-host/src/serve/journal.rs','rust/wa-host/src/serve/scheduler.rs','rust/Cargo.lock'])if(fs.existsSync(path.join(repo,file)))out[file]=hash(path.join(repo,file));function walk(dir){for(const e of fs.readdirSync(dir,{withFileTypes:true})){const p=path.join(dir,e.name);if(e.isDirectory())walk(p);else if(e.name.endsWith('.lua'))out[path.relative(repo,p).replaceAll('\\','/')]=hash(p);}}walk(path.join(repo,'lua'));return out;}
+function verify(repo,binary,receipt){const saved=JSON.parse(fs.readFileSync(receipt));if(JSON.stringify(saved.sources)!==JSON.stringify(sources(repo))||saved.binary_sha256!==hash(binary))throw Error('run_key_build_binding_mismatch');return saved;}
+module.exports={verify,sources};
+if(require.main===module){const [mode,repo,binary,receipt]=process.argv.slice(2);if(mode==='verify'){verify(repo,binary,receipt);console.log('binding verified');}else if(mode==='build'){const before=sources(repo);const r=spawnSync('cargo',['build','--offline','--manifest-path',path.join(repo,'rust/Cargo.toml'),'-p','wa-host','--target-dir',path.dirname(path.dirname(binary))],{cwd:repo,env:{...process.env,CARGO_BUILD_JOBS:'2'},stdio:'inherit'});if(r.status!==0)process.exit(r.status||1);if(JSON.stringify(before)!==JSON.stringify(sources(repo)))throw Error('source_changed_during_build');fs.writeFileSync(receipt,JSON.stringify({kind:'caller-attested-cargo-build',sources:before,binary_sha256:hash(binary)},null,2));}else throw Error('usage build|verify repo binary receipt');}

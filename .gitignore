__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local databases and runtime state: never versioned.
*.db
*.db-wal
*.db-shm
.wasm-agent/

# Rust build output (host workspace and standalone plugin crates).
target/

# Secrets: never version these.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*credentials*.json
*credential*.json
*secret*.json
service-account*.json
id_rsa*
id_ed25519*
id_ecdsa*

# handoff.sh runtime output. The report and the run marker are per-run and must not be
# versioned; the baseline count is deliberately NOT ignored - property 1 needs a baseline
# that was reviewed, and a number nobody committed cannot be reviewed.
.handoff/last-report.txt
.handoff/running

# Scratch files: the probe scripts a run writes for itself. The convention is the mechanism.
tmp-*

# A dev-mode node's own home (scripts/dev-agent.cmd): a candidate node must not write the
# operator's ledger, and its database, identity and env copy are not source.
.wasm-agent-dev/

# wa-graph spike database (rust/wa-graph). A derived index, never source.
.wa-graph/

# The harness evaluator's frozen tasks are real operator work - prompts, message text, mail, machine
# names - and live under the node's own state directory (<config>/evaluator), never here. These two
# names are the shapes a mistaken copy or a redirected state directory would take, so they are ignored
# before anything can stage them; .githooks/pre-commit refuses a forced add as well.
harness-evaluator/tasks/
harness-evaluator/state/

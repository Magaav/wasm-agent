#!/usr/bin/env bash
# Refuse an agent's commit on the integration branch.
#
# AGENTS.md says agents hand off a branch and the human merges. That was advice, and one
# run committed straight to main anyway: a good commit, on the wrong route, and it sat
# there unreviewed because nobody was watching the branch it was not on. A rule that is
# only prose fails exactly when prose is least likely to be read - mid-task, by an agent
# that has already decided its work is done.
#
# This is enforcement, and it uses the one thing the trailer convention can prove: under a
# shared synthetic git identity, `Agent:` is the only trace of the harness behind a
# commit. An `Agent: wasm-agent ...` commit on main is therefore refused here, and so is a
# commit with no trailer at all.
#
# It is a commit-msg hook, not pre-commit, because the message is what is being judged and
# only commit-msg is handed it. (The first version was a pre-commit hook, could not see the
# message, and rejected everything - caught by trying both cases before believing it.)
#
# Escape hatch for the human landing agent work: WASM_AGENT_ALLOW_MAIN=1.
set -uo pipefail

branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
case "$branch" in
  main|master) ;;
  *) exit 0 ;;
esac

message_file="${1:-}"
message=""
if [ -n "$message_file" ] && [ -f "$message_file" ]; then
  message="$(cat "$message_file")"
fi

trailer="$(printf '%s\n' "$message" | grep -E '^Agent:' | tail -1 || true)"

# A merge is a different thing. Its provenance is its *parents*: the second parent is the branch that
# was merged, so the commit says where the work came from without anyone writing it down. What a trailer
# would add is the integrator's session - which a hook cannot know, and inventing it would put a false
# name in the record. So a merge is accepted when its subject names the branch it merged, which is the
# convention this repository already uses: merge(pi): ..., merge(wasm_the_first): ...
#
# Note for whoever edits this: each worktree runs *its own* copy of this file, because core.hooksPath is
# a relative path. A worktree that has not merged main runs the old hook. That is a real trap, and it is
# why this file is edited in the checkout where merges happen.
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
  subject="$(printf '%s\n' "$message" | head -1)"
  # Two forms, both of which name the branch: this repository's own 'merge(<branch>): ...', and git's
  # default "Merge branch 'x'" / "Merge remote-tracking branch 'origin/x'". Accepting git's default is
  # what makes `git merge --no-edit` work, so the rule costs nothing in the ordinary case and still
  # refuses a subject that says nothing. Written without regex escapes: matching ')' with -F and the
  # rest with a plain pattern avoids a layer of quoting that has already cost two round trips today.
  if printf '%s' "$subject" | grep -qE '^merge' && printf '%s' "$subject" | grep -qF '):' ; then
    exit 0
  fi
  if printf '%s' "$subject" | grep -qE '^Merge (remote-tracking )?branch ' ; then
    exit 0
  fi
  cat >&2 <<MESSAGE
commit-msg: a merge must name the branch it merged.

  $subject

The parents of a merge record where the work came from; the subject should say it in words, as
'merge(<branch>): what it brings'. A merge with a vague subject leaves the reader to diff the parents
to find out what happened - and a merge cannot carry an 'Agent:' trailer truthfully, because the hook
has no way to know which harness and session is integrating.
MESSAGE
  exit 1
fi

if [ -z "$trailer" ]; then
  cat >&2 <<'MESSAGE'
commit-msg: no `Agent:` trailer.

Every commit here is authored by a shared synthetic identity, so the trailer is the only
record of which harness and session produced it. Add one:

    Agent: pi session=<id>
    Agent: wasm-agent node=<name> role=<role>
MESSAGE
  exit 1
fi

if printf '%s' "$trailer" | grep -q '^Agent: *wasm-agent' && [ "${WASM_AGENT_ALLOW_MAIN:-0}" != "1" ]; then
  cat >&2 <<MESSAGE
commit-msg: refusing an agent commit on '$branch'.

  $trailer

Your branch is the deliverable: put this on one (git switch -c <task>), rebase it onto
origin/main so it still merges, push it, and let the human merge. If you are the human
landing work an agent produced, re-run with WASM_AGENT_ALLOW_MAIN=1 and a trailer that
says so.
MESSAGE
  exit 1
fi

exit 0

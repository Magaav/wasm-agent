# Copy to .env and fill in. `.env` is gitignored — never commit real secrets.

# Git access to this repository (write deploy key).
WASM_AGENT_GIT_REMOTE=git@github-wasm-agent:Magaav/wasm-agent.git
WASM_AGENT_GIT_KEY_FILE=/home/ubuntu/.ssh/id_ed25519_wasm_agent
WASM_AGENT_GIT_PUBLIC_KEY=
# Inline private key (optional; the file above is preferred).
# WASM_AGENT_GIT_PRIVATE_KEY='-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----'

# Model provider for `wa chat` (see also ~/.wasm-agent/env).
WASM_AGENT_LLM_BASE_URL=https://opencode.ai/zen/go/v1
WASM_AGENT_LLM_MODEL=deepseek-v4.1-flash
# WASM_AGENT_LLM_API_KEY=

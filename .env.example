# Copy to .env and fill in. `.env` is gitignored — never commit real secrets.

# Git access to this repository (write deploy key).
WASM_AGENT_GIT_REMOTE=git@github-wasm-agent:Magaav/wasm-agent.git
WASM_AGENT_GIT_KEY_FILE=/home/ubuntu/.ssh/id_ed25519_wasm_agent
WASM_AGENT_GIT_PUBLIC_KEY=
# Inline private key (optional; the file above is preferred).
# WASM_AGENT_GIT_PRIVATE_KEY='-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----'

# Model provider for `wa chat` (see also ~/.wasm-agent/env).
WASM_AGENT_LLM_BASE_URL=https://opencode.ai/zen/go/v1
WASM_AGENT_LLM_MODEL=deepseek-v4.1-flash
# WASM_AGENT_LLM_API_KEY=
# Retry once when the provider sends no response headers. Set to 0 to avoid the small risk of paying
# twice when the upstream completed an inference but its edge lost the response (accepted range 0-3).
WASM_AGENT_PROVIDER_RESPONSE_RETRIES=1
# An HTTP refusal (429/5xx) is retried by default: the provider answered and did not serve the
# request, so the run waits instead of ending. Three attempts, 2 s doubling to a 60 s cap, and the
# provider's own Retry-After is honoured. 0 disables the bucket (accepted range 0-8); setting
# WASM_AGENT_PROVIDER_RETRIES also acts as the off-switch for every provider retry.
# WASM_AGENT_PROVIDER_RATE_LIMIT_RETRIES=3
# WASM_AGENT_PROVIDER_RATE_LIMIT_DELAY_MS=2000
# WASM_AGENT_PROVIDER_RATE_LIMIT_MAX_DELAY_MS=60000
# An empty stop - `finish_reason=stop` with no text, no reasoning and no tool call - is retried
# twice by default, 0.5 s then 1 s, and only then fails the turn with that reason on the error.
# It returned nothing, so a retry cannot duplicate a tool call or swallow visible text; it does
# cost a second inference. Accepted range 0-4; `WASM_AGENT_PROVIDER_RETRIES=0` disables it too.
# WASM_AGENT_PROVIDER_EMPTY_RETRIES=2
# WASM_AGENT_PROVIDER_EMPTY_DELAY_MS=500
